---
import Layout from "../layouts/Layout.astro";
import data from "../../public/data.json";
import "../../assets/scss/astro-ecommerce.scss";
import Navbar from "../components/navbar";
import Footer from "../components/footer";
import CardProduct from "../components/products/cardProduct";
import TestimonialsFade from "../components/promo/testimonialsFade";
---

<Layout title="Serat Daun - Produk Berkualitas">
    <main>
        <Navbar client:load />

        <!-- Hero Section -->
        <div
            class="page-header min-vh-75"
            style="background-image: url('../images/bg2.jpg'); background-size: cover; background-position: center;"
        >
            <span class="mask bg-gradient-dark opacity-4"></span>
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-lg-8 text-center mx-auto my-auto">
                        <h1 class="text-white fade-in">
                            Selamat Datang di Serat Daun
                        </h1>
                        <p class="lead text-white opacity-8 mt-3">
                            Koleksi produk berkualitas pilihan terbaik untuk
                            Anda
                        </p>
                        <a href="#products" class="btn btn-lg btn-white mt-4"
                            >Lihat Produk</a
                        >
                    </div>
                </div>
            </div>
        </div>

        <div class="container my-5" id="products">
            <!-- Featured Products Section -->
            <div class="d-block text-center mb-5">
                <h2 class="font-weight-bold">Produk Unggulan</h2>
                <p class="text-body">
                    Temukan produk terbaik kami dengan kualitas premium
                </p>
            </div>

            <div class="row mb-5">
                {
                    data.products.map((product) => (
                        <div class="col-md-6 col-lg-3 mb-4">
                            <CardProduct
                                client:load
                                thumb_src={product.thumb_src}
                                thumb_alt={product.thumb_alt || "product-image"}
                                color={product.color}
                                title={product.title}
                                description={product.description || ""}
                                price={product.price}
                                colors={product.colors || []}
                                position="center"
                                productId={product.id}
                            />
                        </div>
                    ))
                }
            </div>

            <!-- Categories Section -->
            <div class="my-10">
                <div class="d-block text-center mb-5">
                    <h3>Jelajahi Kategori</h3>
                    <p class="text-body">
                        Temukan berbagai pilihan produk berdasarkan kategori
                    </p>
                </div>
            </div>

            <!-- Testimonials Section -->
            <div class="mt-8 mb-10">
                <h3 class="text-center mb-5">Apa Kata Pelanggan Kami</h3>
                <TestimonialsFade
                    client:load
                    pageHeaderBgImg="https://images.unsplash.com/photo-1519642918688-7e43b19245d8?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2676&q=80"
                    pageHeaderMinVh="50vh"
                />
            </div>
        </div>

        <Footer client:load />
    </main>
</Layout>

<style>
    .fade-in {
        animation: fadeIn 1s ease-in;
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
